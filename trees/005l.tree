\subtree[007x]{
  \taxon{VU-AL-2026}
  \title{Exercise Notes}
  \p{
    One preface in regard to notation:
  }
  \ul{
    \li{
      \strong{Frame} - to denote a frame I'll use either 
      ##{
        (W, R) \equiv \mathcal F
      }
    }
    \li{
      \strong{Accessibility Relation} - to denote the \em{accessibility} or \em{transition} relation I will use 
      ##{
        R \subseteq W \times W \equiv R[x] = \{x \in W \mid R x y \} \equiv \forall x \in W.\ x R y
      }
      conceptually it's all the same thing just the pairs of transitions existing in the model where the first index denotes the tail/start/source and the second index the target/tip/successor.
    }
  }
  \put\transclude/expanded{false}


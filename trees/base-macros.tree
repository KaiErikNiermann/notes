\title{Basic macros}

\import{erct-latex-preamble}

\xmlns:html{http://www.w3.org/1999/xhtml}

\def\nowrap[body]{\<html:span>[style]{white-space: nowrap}{\body}}

% \comment{anchored}{note} — a margin "comment" / aside (Word-style). The first
% arg is the prose span being commented on (rendered underlined inline); the
% second is the note, lifted into the right margin by the renderer + the
% margin-comments.ts geometry module (a plain end-of-section list without JS).
%! sig \comment(anchored: content, note: content)
\def\comment[anchored][note]{\<html:span>[class]{comment}{\<html:span>[class]{comment-anchored}{\anchored}\<html:span>[class]{comment-note}{\note}}}
\def\mark[body]{\<html:mark>{\body}}
\def\dem[body]{\strong{\body}}

\def\table[body]{
  \<html:table>[class]{data-table}{\body}
}
\def\tr[body]{
  \<html:tr>{\body}
}
\def\td[body]{
  \<html:td>{\body}
}
\def\th[body]{
  \<html:th>{\body}
}
\def\hr{
  \<html:hr>{}
}

\alloc\base/tex-preamble

\def\texfig[~body]{
 \scope{
  \put?\base/tex-preamble{
   \latex-preamble/string-diagrams
   \latex-preamble/diagrams
  }
  \figure{\tex{\get\base/tex-preamble}{\body{}}}
 }
}

\def\ltexfig[url][~body]{
 \scope{
  \put?\base/tex-preamble{
   \latex-preamble/string-diagrams
   \latex-preamble/diagrams
  }
  \figure{
   \<html:a>[href]{\url}[target]{_blank}[class]{quiver-link}{
    \tex{\get\base/tex-preamble}{\body{}}
   }
  }
 }
}

\def\infrule[~body]{
  \scope{
    \put?\base/tex-preamble{
     \latex-preamble/mathpar
    }
    \tex{\get\base/tex-preamble}{\begin{mathpar}\body{}\end{mathpar}}
  }
}

\def\align[~body]{
 \scope{
  \put?\base/tex-preamble{
   \latex-preamble/align
  }
  \tex{\get\base/tex-preamble}{
    \begin{align*}
      \body{}
    \end{align*}
  }
 }
}

\def\texmath[~body]{
 \scope{
  \put?\base/tex-preamble{
   \latex-preamble/mathpar
  }
  \tex{\get\base/tex-preamble}{\[\body{}\]}
 }
}

\def\proof[body]{
  \scope{
    \put\transclude/toc{false}
    \subtree{
      \taxon{Proof}
      \body
    }
  }
}

\def\grammar[body]{
  \scope{
    \put?\base/tex-preamble{
      \latex-preamble/bnf
    }
    \tex{\get\base/tex-preamble}{
      \begin{center}
        \begin{bnf}(
          prod-delim = {--},
          or-sym = {},
          prod-sep = 5pt,
        )[
          colspec = {llcll},
          column{1} = {font=\sffamily},
          column{2} = {mode=dmath},
          column{4} = {font=\ttfamily},
          column{5} = {font=\itshape\color{gray}},
        ]
          \body
        \end{bnf}
      \end{center}
    }
  }
}

\def\solution[body]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/expanded{false}
    \subtree{
      \taxon{Solution}
      \body
    }
  }
}

\def\Con[arg1]{#{\mathsf{\arg1}}}
\def\BoldSymbol[arg1]{#{\boldsymbol{\arg1}}}
\def\prn[x]{#{{\mathopen{}\left(\x\right)\mathclose{}}}}
\def\brc[x]{#{{\mathopen{}\left\{\x\right\}\mathclose{}}}}
\def\brk[x]{#{{\mathopen{}\left [\x\right ]\mathclose{}}}}
\def\bbrk[x]{#{{\mathopen{}\llbracket\x\rrbracket\mathclose{}}}}
\def\vrt[x]{#{{\mathopen{}\left\lvert\x\right\rvert\mathclose{}}}}
\def\vvrt[x]{#{{\mathopen{}\left\lVert\x\right\rVert\mathclose{}}}}
\def\gl[x]{#{{\mathopen{}\left\langle\x\right\rangle\mathclose{}}}}
\def\floors[x]{#{{\mathopen{}\left\lfloor\x\right\rfloor\mathclose{}}}}

\def\Sub[arg1]{#{_{\arg1}}}
\def\Sup[arg1]{#{^{\arg1}}}
\def\SubSup[arg1][arg2]{#{_{\arg1}^{\arg2}}}
\def\Sl[arg1][arg2]{#{{\arg1}\Sub{/\arg2}}}
\def\Homs[arg1]{#{\mathbf{hom}\Sub{\arg1}}}
\def\Hom[arg1][arg2][arg3]{#{\mathbf{hom}\Sub{\arg1}\prn{\arg2,\arg3}}}
\def\Ob[arg1]{#{\mathbf{ob}\Sub{\arg1}}}
\def\Idn[arg1]{#{1\Sub{\arg1}}}
\def\SET{#{\mathbf{Set}}}
\def\InvImg[arg1]{#{\arg1\Sup{*}}}
\def\DirImg[arg1]{#{\arg1\Sub{*}}}
\def\OpCat[arg1]{#{\arg1\Sup{\mathsf{op}}}}
\def\ObjTerm[arg1]{#{\mathbf{1}\Sub{\arg1}}}
\def\ObjInit[arg1]{#{\mathbf{0}\Sub{\arg1}}}
\def\tick{#{'}}
\def\Cod[arg1]{#{\Con{cod}\Sub{\arg1}}}
\def\CoSl[arg1][arg2]{#{\arg2\Sup{\setminus \arg1}}}
\def\FibProd[arg1][arg2][arg3]{#{\arg1\mathbin{\times\Sub{\arg2}}\arg3}}
\def\Mor[arg1][arg2][arg3]{#{{\arg2}\xrightarrow{{\arg1}}{\arg3}}}
\def\Comma[arg1][arg2]{#{{\arg1}\downarrow{\arg2}}}

\def\big-symbol[sym]{\mathchoice{\textstyle\sym}{\textstyle\sym}{\scriptstyle\sym}{\scriptscriptstyle\sym}}

\def\ixsum[ix]{#{\big-symbol{\sum_{\prn{\ix}}}}}
\def\covsum[ix]{#{\big-symbol{\oint_{\prn{\ix}}}}}
\def\ctrvsum[ix]{#{\big-symbol{\int_{\prn{\ix}}}}}
\def\ixprod[ix]{#{\big-symbol{\prod_{\prn{\ix}}}}}
\def\dcoprod[ix]{#{\big-symbol{\coprod_{\prn{\ix}}}}}
\def\iixprod[ix]{#{\big-symbol{\prod_{\brc{\ix}}}}}
\def\neq{#{\ \mathrlap{\,/}{=}\ }}

\def\lam[x]{\lambda{\x}\mathpunct{.}}
\def\inv{^{-1}}

\def\Lim[arg1]{\operatorname{lim}_{\arg1}}
\def\Colim[arg1]{\operatorname{colim}_{\arg1}}

\def\C{#{\mathcal{C}}}

\def\FinPow[X]{#{\mathcal{P}\Sub{\mathit{fin}}\prn{\X}}}
\def\Psh{#{\operatorname{Pr}}}

\def\Tr{#{\operatorname{Tr}}}
\def\argmax{#{\operatorname*{arg\,max}}}
\def\argmin{#{\operatorname*{arg\,min}}}
\def\EX{#{\mathbb{E}}}
\def\Var{#{\operatorname{Var}}}
\def\Cov{#{\operatorname{Cov}}}
\def\Bias{#{\operatorname{Bias}}}
\def\Corr{#{\operatorname{Corr}}}
\def\sd{#{\operatorname{sd}}}
\def\se{#{\operatorname{se}}}
\def\MSE{#{\operatorname{MSE}}}
\def\RMSE{#{\operatorname{RMSE}}}

\def\Bern{#{\operatorname{Bernoulli}}}
\def\Binom{#{\operatorname{Binomial}}}
\def\Poiss{#{\operatorname{Poisson}}}
\def\Unif{#{\operatorname{Uniform}}}
\def\Mult{#{\operatorname{Multinomial}}}
\def\Dir{#{\operatorname{Dirichlet}}}
\def\Beta{#{\operatorname{Beta}}}
\def\Norm{#{\operatorname{Normal}}}
\def\Logis{#{\operatorname{Logistic}}}
\def\Lap{#{\operatorname{Laplace}}}

\def\N{#{\mathbb{N}}}
\def\Q{#{\mathbb{Q}}}
\def\Z{#{\mathbb{Z}}}
\def\R{#{\mathbb{R}}}
\def\F{#{\mathbb{F}}}
\def\E{#{\mathbb{E}}}

\def\cobs{#{\operatorname{obs}}}
\def\csec{#{\operatorname{sec}}}
\def\cpc{#{\operatorname{pc}}}
\def\sslist{#{\mathrel{\prec_s}}}
\def\mand{#{\quad\text{ and }\quad}}
\def\tpacons{#{T^{\text{PA}}_{\texttt{cons}}}}
\def\lwand{#{\mathbin{-*}}}

\def\cif{#{\texttt{if}}}
\def\cthen{#{\texttt{then}}}
\def\cInts{#{\texttt{Ints}}}
\def\cint{#{\texttt{int}}}
\def\catom{#{\texttt{atom}}}
\def\cnil{#{\texttt{nil}}}
\def\celse{#{\texttt{else}}}
\def\clet{#{\texttt{let}}}
\def\cin{#{\texttt{in}}}
\def\cwhile{#{\texttt{while}}}
\def\cdo{#{\texttt{do}}}
\def\cskip{#{\texttt{skip}}}
\def\cass{#{\texttt{:=}}}
\def\ctrue{#{\texttt{true}}}
\def\cfalse{#{\texttt{false}}}
\def\cassert{#{\texttt{assert}}}
\def\cassume{#{\texttt{assume}}}
\def\cabort{#{\texttt{abort}}}
\def\cfn{#{\texttt{fun}}}
\def\creturn{#{\texttt{return}}}

\def\cwp{#{\texttt{wp}}}
\def\cvc{#{\texttt{vc}}}
\def\cspc{#{\texttt{post}}}
\def\caspc{#{\texttt{post\#}}}

\def\cInt{#{\texttt{Int}}}
\def\cVar{#{\texttt{Var}}}
\def\cVars{#{\texttt{Vars}}}
\def\cLocations{#{\texttt{Locations}}}
\def\cHeap{#{\texttt{Heap}}}
\def\cState{#{\texttt{State}}}
\def\cStore{#{\texttt{Store}}}
\def\cAtoms{#{\texttt{Atoms}}}

\def\linpar{#{\mathbin{\bindnasrepma}}}
\def\bvec[arg1]{#{\mathbf{\arg1}}}
\def\ds{#{\displaystyle}}
\def\iid{#{\stackrel{\text{iid}}{\sim}}}
\def\indep{#{\mathrel{\perp\mkern-9mu\perp}}}
\def\given{#{\,\mid\,}}
\def\pr{#{\operatorname{P}}}
\def\like{#{\mathcal{L}}}
\def\loglike{#{\ell}}
\def\normpdf{#{\phi}}
\def\normcdf{#{\Phi}}
%! sig \codeblock(lang: @language, body: content)
\def\codeblock[lang][body]{\<html:pre>[class]{code-block language-\lang}{\<html:code>[class]{language-\lang}{\body}}}

% \verso[name] — placeholder for a Verso-rendered Lean snippet. The build
% pipeline (scripts/build_verso.py + the inline-verso build stage) elaborates
% the anchored region in lean/examples/Examples.lean and splices the rendered
% HTML (with tippy.js type-on-hover) into this div post-XSLT.
\def\verso[name]{\<html:div>[class]{verso-snippet}[data-verso]{\name}{}}

% \d3[name] — mount point for a sidecar d3 figure defined in figures/<name>.ts.
% The build (scripts/build/stages/d3-figures.ts) bundles figures + the shared
% runtime into output/notes/d3-assets/figures.js; forester.js lazy-loads it on
% pages that contain a figure and calls the figure's render() into this element.
%! sig \d3(name: @figure)
\def\d3[name]{\<html:figure>[class]{d3-figure}[data-d3]{\name}{}}

% \d3p[name]{params} — same, with per-call params. `params` is a key=value list
% separated by `;`, `,`, or newlines (e.g. {bins=40; n=1200}); the runtime
% parses it into ctx.params for the figure's render().
%! sig \d3p(name: @figure, params: opaque)
\def\d3p[name][params]{\<html:figure>[class]{d3-figure}[data-d3]{\name}[data-d3-params]{\params}{}}

% \d3inline[name]{...} — throwaway inline figure. Wrap the body in
% \startverb ... \stopverb. Runs with d3, el, theme, width, height, params in
% scope. No highlighting/type-checking — graduate to figures/<name>.ts when it
% grows. The non-executing script type keeps the JS safe from XSLT escaping;
% the runtime reads + entity-decodes its text content.
%! sig \d3inline(name: @figure, body: content)
\def\d3inline[name][body]{\<html:figure>[class]{d3-figure}[data-d3-inline]{\name}{\<html:script>[type]{application/x-d3-inline}{\body}}}

% \d3inlinep[name]{params}{body} — inline figure with per-call params (same
% key=value format as \d3p). Wrap the body in \startverb/\stopverb.
%! sig \d3inlinep(name: @figure, params: opaque, body: content)
\def\d3inlinep[name][params][body]{\<html:figure>[class]{d3-figure}[data-d3-inline]{\name}[data-d3-params]{\params}{\<html:script>[type]{application/x-d3-inline}{\body}}}

% \embed[opts]{target}{caption} — inline an attachment's CONTENT (not just a
% download link). `opts` = a mode plus optional flags, space-separated:
%   image [width=..] [align=left|center|right]   — render the image
%   code                                         — codeblock, language from the file extension
%   raw                                          — the text as an annotated block
% `target` is `#artifact:<key>` (a local attachment) or an external URL (image only;
% an external target is shown inline but NOT added to the Attachments panel).
% `caption` may be empty ({}). Emits a placeholder the renderer/inline-assets stage
% fills in (same idiom as \verso / \d3). Pair with \meta{artifact-source:<key>}{\cite{..}}
% to carry provenance into the caption + Attachments row + bottom References.
%! sig \embed(opts: flags{mode: image|code|raw, width?: number, align?: left|center|right}, target: @artifact-ref, caption?: content)
\def\embed[opts][target][caption]{\<html:figure>[class]{artifact-embed}[data-embed]{\target}[data-opts]{\opts}{\<html:figcaption>{\caption}}}
\def\shift[arg1][arg2][arg3]{#{\uparrow^{\arg1,\arg2}_{\arg3}}}
\def\deltaeq[arg1][arg2]{#{\delta(\arg1{=}\arg2)}}
\def\defeq{#{\triangleq}}
\def\po{#{\sqsubseteq}}
\def\lrbrack[arg1]{#{\llbracket \arg1 \rrbracket}}
\def\FV[arg1]{#{\operatorname{FV}(\arg1)}}
\def\dom[arg1]{#{\operatorname{dom}(\arg1)}}
\def\Mod[arg1]{#{\operatorname{Mod}(\arg1)}}
\def\cf[arg1]{#{\texttt{\arg1}}}

\def\citek[uid]{\let\escape[x]{\x}[\escape{[\uid]}](\uid)}

% Citation macro with auto-numbering support
% Usage: \cite{reference-tree-id}
% The [0] is a placeholder that will be replaced by JavaScript with the actual number
%! sig \cite(uid: @bib-ref)
\def\cite[uid]{\<html:span>[class]{citation}{\let\escape[x]{\x}[\escape{[0]}](\uid)}}

% Symbol definition + reference with on-hover preview.
% \symdef[id]{description body}        — anchor at the point of definition.
% \symref[id]{display name}            — inline link; on hover/focus a styled
%                                        popover renders the body of the matching
%                                        \symdef. JS hydrates the preview at load.
\def\symdef[id][desc]{
  \<html:dfn>[class]{symdef}[id]{sym-\id}{\desc}
}

\def\symref[id][name]{\<html:span>[class]{symref}{\<html:a>[class]{symref-link}[href]{#sym-\id}[data-sym]{\id}{\name}\<html:span>[class]{symref-preview}[role]{tooltip}{}}}

\xmlns:jms-indent{jonmsterling:indenting}

\def\iblock[body]{
 \<jms-indent:block>{\body}
}

\def\irow[body]{
 \<jms-indent:row>{\body}
}

\p{
  This tree defines the basic notational macros used across my forest.
}

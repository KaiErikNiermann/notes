\title{Feature gallery}
\import{base-macros}

\p{A guided tour of everything this site can render: basic styling and
typography, the full mathematics stack (inline and display KaTeX, LaTeX-compiled
commutative diagrams, BNF grammars, and inference rules), syntax-highlighted
code, Lean snippets with type-on-hover, symbol-definition hovers, interactive d3
graphs, cross-references and citations, and build-time Datalog queries.}

\p{Each section below is a self-contained tree, transcluded here but also
addressable on its own — the transclusion you are looking at is itself one of
the features on display.}

\put\transclude/toc{false}
\put\transclude/expanded{true}

